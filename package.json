{
  "name": "tellaflow",
  "version": "0.6.9",
  "description": "macOS menubar dictation app powered by Whisper",
  "main": "src/main/index.js",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "dev": "concurrently \"npm run dev:renderer\" \"sleep 2 && electron .\"",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:renderer && electron-builder --mac --publish never",
    "start": "electron .",
    "dev:sign": "codesign --force --deep --sign - --options runtime --entitlements build/entitlements.mac.plist node_modules/electron/dist/Electron.app && codesign --force --sign - node_modules/keyspy/runtime/MacKeyServer",
    "download-model": "bash scripts/download-model.sh",
    "test-wav": "DYLD_LIBRARY_PATH=./node_modules/@kutalia/whisper-node-addon/dist/mac-arm64:$DYLD_LIBRARY_PATH node scripts/test-whisper.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "DYLD_LIBRARY_PATH=./node_modules/@kutalia/whisper-node-addon/dist/mac-arm64:$DYLD_LIBRARY_PATH vitest run --config vitest.config.integration.ts"
  },
  "author": "Tellaflow",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@kutalia/whisper-node-addon": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "keyspy": "^1.1.1",
    "lucide-react": "^1.7.0",
    "node-llama-cpp": "^3.18.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sherpa-onnx-node": "^1.12.35",
    "tailwind-merge": "^3.5.0"
  }
}
