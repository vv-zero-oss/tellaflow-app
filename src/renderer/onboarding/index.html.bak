<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Whisper Studio Setup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root {
  --bg: transparent;
  --surface: rgba(20,20,24,0.85);
  --surface-2: rgba(30,30,36,0.9);
  --border: rgba(255,255,255,0.08);
  --text: #e4e0db;
  --text-dim: #8a877f;
  --accent: #d4a24e;
  --accent-hover: #e0b060;
  --success: #4a9e6d;
  --code: #7eb8e0;
  --recording: #c9443d;
}
html, body {
  height: 100%;
  font-family: 'DM Sans', system-ui, sans-serif;
  color: var(--text);
  background: var(--bg);
  -webkit-app-region: drag;
  user-select: none;
}
button, input { -webkit-app-region: no-drag; }

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 60px 48px 36px;
}

/* Steps indicator */
.steps-indicator {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 40px;
}
.step-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border);
  transition: background 0.3s, transform 0.3s;
}
.step-dot.active { background: var(--accent); transform: scale(1.3); }
.step-dot.done { background: var(--success); }

/* Step panels */
.step { display: none; flex-direction: column; align-items: center; flex: 1; }
.step.active { display: flex; }

h1 {
  font-family: 'Instrument Serif', serif;
  font-size: 2rem;
  font-weight: 400;
  letter-spacing: -0.02em;
  text-align: center;
  margin-bottom: 12px;
}
h1 span { color: var(--accent); }

.subtitle {
  color: var(--text-dim);
  font-size: 0.9rem;
  text-align: center;
  line-height: 1.6;
  max-width: 380px;
  margin-bottom: 32px;
}

/* Hotkey capture */
.hotkey-capture {
  width: 100%;
  max-width: 340px;
  height: 80px;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.3s, box-shadow 0.3s;
  margin-bottom: 16px;
}
.hotkey-capture:hover { border-color: var(--accent); }
.hotkey-capture.listening {
  border-color: var(--accent);
  box-shadow: 0 0 30px rgba(212,162,78,0.15);
}
.hotkey-capture .key-display {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.3rem;
  color: var(--text);
  letter-spacing: 0.05em;
}
.hotkey-capture .prompt {
  font-size: 0.85rem;
  color: var(--text-dim);
}

.hotkey-hint {
  font-size: 0.78rem;
  color: var(--text-dim);
  margin-bottom: 24px;
}

/* Permission checks */
.perm-list {
  width: 100%;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}
.perm-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  cursor: pointer;
  transition: border-color 0.2s;
}
.perm-item:hover { border-color: var(--accent); }
.perm-item.granted { border-color: var(--success); }
.perm-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.perm-icon svg {
  width: 18px;
  height: 18px;
  stroke: var(--text-dim);
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.perm-item.granted .perm-icon svg { stroke: var(--success); }
.perm-info { flex: 1; }
.perm-name { font-size: 0.9rem; font-weight: 500; }
.perm-status {
  font-size: 0.75rem;
  color: var(--text-dim);
  margin-top: 2px;
}
.perm-item.granted .perm-status { color: var(--success); }
.perm-check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s, border-color 0.3s;
}
.perm-item.granted .perm-check {
  background: var(--success);
  border-color: var(--success);
}
.perm-check svg {
  width: 12px;
  height: 12px;
  stroke: white;
  fill: none;
  stroke-width: 2.5;
  opacity: 0;
  transition: opacity 0.3s;
}
.perm-item.granted .perm-check svg { opacity: 1; }

/* Accessibility instructions */
.access-instructions {
  width: 100%;
  max-width: 380px;
  background: rgba(126,184,224,0.08);
  border: 1px solid rgba(126,184,224,0.2);
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 12px;
  display: none;
}
.access-instructions.visible { display: block; }
.instructions-text {
  display: flex;
  gap: 10px;
  font-size: 0.8rem;
  line-height: 1.55;
  color: var(--text);
}
.instructions-text em { color: var(--code); font-style: normal; font-weight: 600; }
.instructions-text strong { color: var(--text); }
.instructions-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  stroke: var(--code);
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  margin-top: 1px;
}
.access-warning {
  width: 100%;
  max-width: 380px;
  font-size: 0.75rem;
  color: var(--accent);
  text-align: center;
  margin-bottom: 16px;
  display: none;
}
.access-warning.visible { display: block; }

/* Restart banner */
.restart-banner {
  display: none;
  align-items: center;
  gap: 12px;
  width: 100%;
  max-width: 380px;
  padding: 14px 18px;
  background: rgba(74,158,109,0.1);
  border: 1px solid rgba(74,158,109,0.3);
  border-radius: 12px;
  margin-bottom: 16px;
}
.restart-banner.visible { display: flex; }
.restart-icon {
  width: 22px; height: 22px; flex-shrink: 0;
  stroke: var(--success); fill: none;
  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
}
.restart-title { font-size: 0.85rem; font-weight: 600; color: var(--success); }
.restart-desc { font-size: 0.75rem; color: var(--text-dim); margin-top: 2px; }

/* Buttons */
.btn-row {
  display: flex;
  gap: 12px;
  margin-top: auto;
  width: 100%;
  justify-content: center;
}
.btn {
  padding: 12px 32px;
  border-radius: 10px;
  border: none;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
}
.btn:active { transform: scale(0.97); }
.btn-primary {
  background: var(--accent);
  color: #1a1a1f;
}
.btn-primary:hover { background: var(--accent-hover); }
.btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
}
.btn-secondary:hover { background: var(--surface-2); }

/* Welcome icon */
.welcome-icon {
  width: 80px;
  height: 80px;
  border-radius: 20px;
  background: linear-gradient(135deg, var(--accent), #e07a30);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}
.welcome-icon svg {
  width: 40px;
  height: 40px;
  stroke: white;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
</style>
</head>
<body>
<div class="container">
  <div class="steps-indicator">
    <div class="step-dot active" data-step="0"></div>
    <div class="step-dot" data-step="1"></div>
    <div class="step-dot" data-step="2"></div>
  </div>

  <!-- Step 1: Welcome -->
  <div class="step active" id="step0">
    <div class="welcome-icon">
      <svg viewBox="0 0 24 24">
        <rect x="9" y="2" width="6" height="12" rx="3"/>
        <path d="M5 10a7 7 0 0 0 14 0"/>
        <line x1="12" y1="17" x2="12" y2="22"/>
        <line x1="8" y1="22" x2="16" y2="22"/>
      </svg>
    </div>
    <h1>Welcome to Whisper <span>Studio</span></h1>
    <p class="subtitle">
      Hold your hotkey, speak, release. Your words appear wherever your cursor is — any app, any text field. Fully offline, powered by OpenAI Whisper.
    </p>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="goToStep(1)">Get Started</button>
    </div>
  </div>

  <!-- Step 2: Hotkey -->
  <div class="step" id="step1">
    <h1>Choose Your <span>Hotkey</span></h1>
    <p class="subtitle">
      Press the key you'd like to hold while speaking. We suggest Option (⌥).
    </p>
    <div class="hotkey-capture" id="hotkeyCapture" tabindex="0">
      <span class="key-display" id="keyDisplay">Option (⌥)</span>
    </div>
    <span class="hotkey-hint">Click the box, then press your desired shortcut</span>
    <div class="btn-row">
      <button class="btn btn-secondary" onclick="goToStep(0)">Back</button>
      <button class="btn btn-primary" id="hotkeyNextBtn" onclick="saveHotkeyAndNext()">Continue</button>
    </div>
  </div>

  <!-- Step 3: Permissions -->
  <div class="step" id="step2">
    <h1>Grant <span>Permissions</span></h1>
    <p class="subtitle">
      Whisper Studio needs two permissions to work. Click each to grant access.
    </p>
    <div class="perm-list">
      <div class="perm-item" id="permMic" onclick="grantMic()">
        <div class="perm-icon">
          <svg viewBox="0 0 24 24">
            <rect x="9" y="2" width="6" height="12" rx="3"/>
            <path d="M5 10a7 7 0 0 0 14 0"/>
          </svg>
        </div>
        <div class="perm-info">
          <div class="perm-name">Microphone</div>
          <div class="perm-status" id="micStatus">Click to grant access</div>
        </div>
        <div class="perm-check">
          <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
      </div>
      <div class="perm-item" id="permAccess" onclick="grantAccessibility()">
        <div class="perm-icon">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
            <line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
        </div>
        <div class="perm-info">
          <div class="perm-name">Accessibility</div>
          <div class="perm-status" id="accessStatus">Click to open System Settings</div>
        </div>
        <div class="perm-check">
          <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
      </div>
    </div>
    <div class="access-instructions" id="accessInstructions">
      <div class="instructions-text">
        <svg viewBox="0 0 24 24" class="instructions-icon"><path d="M12 22c5.5 0 10-4.5 10-10S17.5 2 12 2 2 6.5 2 12s4.5 10 10 10z"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        <div>
          <strong>In System Settings:</strong> find <em>Whisper Studio</em> (or <em>Electron</em> during development) in the list and toggle it <strong>ON</strong>. This window will detect it automatically.
        </div>
      </div>
    </div>
    <div class="access-warning" id="accessWarning">
      Hotkey and paste won't work until Accessibility is granted. You can enable it later from the tray menu.
    </div>
    <div class="restart-banner" id="restartBanner">
      <svg viewBox="0 0 24 24" class="restart-icon"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      <div>
        <div class="restart-title">Restart required</div>
        <div class="restart-desc">The app needs to restart for the hotkey to work.</div>
      </div>
      <button class="btn btn-primary" onclick="restartNow()" style="margin-left:auto;padding:8px 20px;font-size:0.82rem;">Restart Now</button>
    </div>
    <div class="btn-row" id="stepBtnRow">
      <button class="btn btn-secondary" onclick="goToStep(1)">Back</button>
      <button class="btn btn-primary" id="finishBtn" onclick="finish()">Finish Setup</button>
    </div>
  </div>
</div>

<script>
let currentStep = 0;
let capturedHotkey = { keycode: 3640, ctrlKey: false, altKey: false, shiftKey: false, metaKey: false, label: 'Option (⌥)' };
let listening = false;
let pendingModifierCode = null;

const CODE_TO_UIOHOOK = {
  KeyA: 30, KeyB: 48, KeyC: 46, KeyD: 32, KeyE: 18, KeyF: 33, KeyG: 34,
  KeyH: 35, KeyI: 23, KeyJ: 36, KeyK: 37, KeyL: 38, KeyM: 50, KeyN: 49,
  KeyO: 24, KeyP: 25, KeyQ: 16, KeyR: 19, KeyS: 31, KeyT: 20, KeyU: 22,
  KeyV: 47, KeyW: 17, KeyX: 45, KeyY: 21, KeyZ: 44,
  Digit0: 11, Digit1: 2, Digit2: 3, Digit3: 4, Digit4: 5, Digit5: 6,
  Digit6: 7, Digit7: 8, Digit8: 9, Digit9: 10,
  Space: 57, Escape: 1, Tab: 15, CapsLock: 58, Enter: 28, Backspace: 14,
  F1: 59, F2: 60, F3: 61, F4: 62, F5: 63, F6: 64,
  F7: 65, F8: 66, F9: 67, F10: 68, F11: 87, F12: 88,
  Minus: 12, Equal: 13, BracketLeft: 26, BracketRight: 27,
  Backslash: 43, Semicolon: 39, Quote: 40, Backquote: 41,
  Comma: 51, Period: 52, Slash: 53,
  ArrowUp: 57416, ArrowDown: 57424, ArrowLeft: 57419, ArrowRight: 57421,
  ShiftLeft: 42, ShiftRight: 54,
  ControlLeft: 29, ControlRight: 3613,
  AltLeft: 56, AltRight: 3640,
  MetaLeft: 3675, MetaRight: 3676,
};

const MODIFIER_LABELS = {
  AltLeft: 'Option (⌥)', AltRight: 'Option (⌥)',
  ControlLeft: 'Control (⌃)', ControlRight: 'Control (⌃)',
  ShiftLeft: 'Shift (⇧)', ShiftRight: 'Shift (⇧)',
  MetaLeft: 'Command (⌘)', MetaRight: 'Command (⌘)',
};
let micGranted = false;
let accessGranted = false;

const hotkeyCapture = document.getElementById('hotkeyCapture');
const keyDisplay = document.getElementById('keyDisplay');

function goToStep(n) {
  document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
  document.getElementById('step' + n).classList.add('active');
  document.querySelectorAll('.step-dot').forEach((d, i) => {
    d.classList.remove('active', 'done');
    if (i < n) d.classList.add('done');
    if (i === n) d.classList.add('active');
  });
  currentStep = n;

  if (n === 2) pollPermissions();
}

hotkeyCapture.addEventListener('click', () => {
  listening = true;
  hotkeyCapture.classList.add('listening');
  keyDisplay.textContent = 'Press your shortcut...';
  keyDisplay.classList.add('prompt');
});

document.addEventListener('keydown', (e) => {
  if (!listening) return;
  e.preventDefault();
  e.stopPropagation();

  // Standalone modifier key — preview it, wait for keyup to confirm
  if (MODIFIER_LABELS[e.code]) {
    const uiCode = CODE_TO_UIOHOOK[e.code];
    const label = MODIFIER_LABELS[e.code];
    capturedHotkey = {
      keycode: uiCode,
      ctrlKey: false, altKey: false, shiftKey: false, metaKey: false,
      label: label,
    };
    keyDisplay.textContent = label;
    keyDisplay.classList.remove('prompt');
    pendingModifierCode = e.code;
    return;
  }

  // Non-modifier key (possibly with modifiers held)
  pendingModifierCode = null;

  const parts = [];
  if (e.ctrlKey) parts.push('Ctrl');
  if (e.altKey) parts.push('Option');
  if (e.shiftKey) parts.push('Shift');
  if (e.metaKey) parts.push('Cmd');

  let keyName = e.key;
  if (e.code === 'Space') keyName = 'Space';
  else if (e.key.length === 1) keyName = e.key.toUpperCase();
  parts.push(keyName);

  const label = parts.join(' + ');
  const uiCode = CODE_TO_UIOHOOK[e.code] || e.keyCode;

  capturedHotkey = {
    keycode: uiCode,
    ctrlKey: e.ctrlKey,
    altKey: e.altKey,
    shiftKey: e.shiftKey,
    metaKey: e.metaKey,
    label: label,
  };

  keyDisplay.textContent = label;
  keyDisplay.classList.remove('prompt');
  hotkeyCapture.classList.remove('listening');
  listening = false;
});

document.addEventListener('keyup', (e) => {
  if (!listening || !pendingModifierCode) return;
  if (e.code === pendingModifierCode) {
    pendingModifierCode = null;
    hotkeyCapture.classList.remove('listening');
    listening = false;
  }
});

function saveHotkeyAndNext() {
  window.whisperStudio.setHotkey(capturedHotkey);
  goToStep(2);
}

async function grantMic() {
  if (micGranted) return;
  try {
    const granted = await window.whisperStudio.requestMicPermission();
    if (granted) {
      micGranted = true;
      document.getElementById('permMic').classList.add('granted');
      document.getElementById('micStatus').textContent = 'Granted';
      updateFinishState();
    }
  } catch {
    document.getElementById('micStatus').textContent = 'Please allow in the dialog';
  }
}

async function grantAccessibility() {
  if (accessGranted) return;

  // Show the native macOS prompt + open the Settings pane
  window.whisperStudio.promptAccessibility();
  window.whisperStudio.openAccessibilitySettings();

  // Show inline instructions
  document.getElementById('accessInstructions').classList.add('visible');
  document.getElementById('accessStatus').textContent = 'Waiting for permission...';

  pollAccessibility();
}

let accessPollId = null;
function pollAccessibility() {
  if (accessPollId) clearInterval(accessPollId);
  accessPollId = setInterval(async () => {
    const ok = await window.whisperStudio.checkAccessibility();
    if (ok) {
      accessGranted = true;
      document.getElementById('permAccess').classList.add('granted');
      document.getElementById('accessStatus').textContent = 'Granted';
      document.getElementById('accessInstructions').classList.remove('visible');
      document.getElementById('accessWarning').classList.remove('visible');
      clearInterval(accessPollId);
      updateFinishState();
      showRestartIfNeeded();
    }
  }, 1500);
}

async function showRestartIfNeeded() {
  const needsRestart = await window.whisperStudio.checkNeedsRestart();
  if (needsRestart) {
    document.getElementById('restartBanner').classList.add('visible');
    document.getElementById('stepBtnRow').style.display = 'none';
  }
}

function restartNow() {
  window.whisperStudio.restartApp();
}

function pollPermissions() {
  grantMicCheck();
  checkAccessNow();
  pollAccessibility();
}

async function grantMicCheck() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    stream.getTracks().forEach(t => t.stop());
    micGranted = true;
    document.getElementById('permMic').classList.add('granted');
    document.getElementById('micStatus').textContent = 'Granted';
    updateFinishState();
  } catch {}
}

async function checkAccessNow() {
  const ok = await window.whisperStudio.checkAccessibility();
  if (ok) {
    accessGranted = true;
    document.getElementById('permAccess').classList.add('granted');
    document.getElementById('accessStatus').textContent = 'Granted';
    document.getElementById('accessWarning').classList.remove('visible');
    showRestartIfNeeded();
  }
  updateFinishState();
}

function updateFinishState() {
  const btn = document.getElementById('finishBtn');
  const warning = document.getElementById('accessWarning');

  // Always enabled — but show warning if accessibility is missing
  btn.disabled = false;
  if (!accessGranted) {
    warning.classList.add('visible');
  } else {
    warning.classList.remove('visible');
  }
}

function finish() {
  if (accessPollId) clearInterval(accessPollId);
  window.whisperStudio.completeOnboarding();
}
</script>
</body>
</html>
